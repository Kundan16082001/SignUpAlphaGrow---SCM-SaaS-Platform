# ================================
# Laravel .gitignore (Comprehensive)
# ================================

# --- Sensitive Environment Files ---
.env
.env.backup
.env.production
.phpunit.result.cache

# --- Custom Auto-Created Folders ---
.sf/
*.sf

# --- Laravel Storage & Cache ---
/storage/*.key
/storage/app/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/app/.gitignore
!/storage/framework/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# --- Vendor (Composer Dependencies) ---
/vendor/

# --- Node Modules (if using npm) ---
/node_modules/
npm-debug.log
yarn-error.log

# --- IDE & Editor Files ---
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Compiled Assets ---
/public/hot
/public/storage
/public/css/
/public/js/
/public/mix-manifest.json
.mix

# --- Homestead & Docker ---
Homestead.json
Homestead.yaml
vagrant-*.box
docker-compose.override.yml

# --- Debug & Logs ---
*.log
 Homestead.yaml
 Homestead.json
 .vagrant/
 .phpunit.result.cache

# --- Backup Files ---
*.bak
*.backup
*.sql

# --- OS Generated ---
desktop.ini
ehthumbs.db